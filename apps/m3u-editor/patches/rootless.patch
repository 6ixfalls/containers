diff --git a/docker/8.4/nginx/nginx.conf b/docker/8.4/nginx/nginx.conf
--- a/docker/8.4/nginx/nginx.conf
+++ b/docker/8.4/nginx/nginx.conf
@@ -6,7 +6,7 @@ worker_processes auto;
 # if you don't set FD's then OS settings will be used which is by default 2000
 worker_rlimit_nofile 50000;
 
-pid /var/run/nginx.pid;
+pid /tmp/m3u-editor/nginx.pid;
 
 events {
     worker_connections  2048;  # Tweak as needed for concurrency
@@ -25,7 +25,13 @@ http {
     # Logs
     # access_log  /var/log/nginx/access.log  main;
     access_log  off;
-    error_log   /var/log/nginx/error.log crit;
+    error_log   /dev/stderr crit;
+
+    client_body_temp_path /tmp/m3u-editor/nginx/client_temp;
+    proxy_temp_path       /tmp/m3u-editor/nginx/proxy_temp;
+    fastcgi_temp_path     /tmp/m3u-editor/nginx/fastcgi_temp;
+    uwsgi_temp_path       /tmp/m3u-editor/nginx/uwsgi_temp;
+    scgi_temp_path        /tmp/m3u-editor/nginx/scgi_temp;
 
     # Other typical directives
     sendfile             on;
diff --git a/docker/8.4/supervisord.conf b/docker/8.4/supervisord.conf
--- a/docker/8.4/supervisord.conf
+++ b/docker/8.4/supervisord.conf
@@ -1,11 +1,11 @@
 [unix_http_server]
-file=/run/supervisord.sock
+file=/tmp/m3u-editor/supervisord.sock
 chmod=0700
 username=m3ue
 password=m3ue
 
 [supervisorctl]
-serverurl=unix:///run/supervisord.sock
+serverurl=unix:///tmp/m3u-editor/supervisord.sock
 username=m3ue
 password=m3ue
 
@@ -15,8 +15,9 @@ supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface
 [supervisord]
 nodaemon=true
 user=%(ENV_SUPERVISOR_PHP_USER)s
-logfile=/var/log/supervisor/supervisord.log
-pidfile=/var/run/supervisord.pid
+logfile=/dev/null
+logfile_maxbytes=0
+pidfile=/tmp/m3u-editor/supervisord.pid
 
 ;-----------------------------------------
 ; PostgreSQL (embedded, local only)
@@ -41,7 +42,7 @@ priority=1
 ;-----------------------------------------
 [program:db-init]
 command=/bin/sh /var/www/html/docker/8.4/db-init.sh
-user=root
+user=%(ENV_SUPERVISOR_PHP_USER)s
 autostart=true
 autorestart=false
 startsecs=0
@@ -52,15 +53,16 @@ stdout_logfile_maxbytes=0
 priority=2
 
 ;-----------------------------------------
-; Cron
+; Laravel scheduler
 ;-----------------------------------------
-[program:crond]
-command=/usr/sbin/crond -f -d 8
+[program:scheduler]
+command=/usr/bin/php /var/www/html/artisan schedule:work --no-interaction
 user=%(ENV_SUPERVISOR_PHP_USER)s
 autostart=true
 autorestart=true
-stdout_logfile=/var/log/cron.out.log
-stderr_logfile=/var/log/cron.err.log
+redirect_stderr=true
+stdout_logfile=/dev/stdout
+stdout_logfile_maxbytes=0
 priority=3
 
 ;-----------------------------------------
@@ -154,9 +156,8 @@ user=%(ENV_SUPERVISOR_PHP_USER)s
 autostart=%(ENV_NETWORK_BROADCAST_ENABLED)s
 autorestart=true
 redirect_stderr=true
-stdout_logfile=/var/log/network-broadcast.log
-stdout_logfile_maxbytes=10MB
-stdout_logfile_backups=3
+stdout_logfile=/dev/stdout
+stdout_logfile_maxbytes=0
 priority=10
 
